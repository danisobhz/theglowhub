{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theglowhub",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/admin.html", "/login", "/login.html", "/uploads/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "theglowhub-catalog",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "theglowhub-images" }],
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 3 * * *"] }
}
